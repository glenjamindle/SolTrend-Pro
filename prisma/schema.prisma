generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Company - Top level organization
model Company {
  id        String   @id @default(cuid())
  name      String
  tier      String   @default("starter")  // starter, professional, enterprise
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  users     User[]
  projects  Project[]
  crews     Crew[]
  subcontractors Subcontractor[]
  rackingProfiles RackingProfile[]
  notifications   Notification[]
}

// User - Team members
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("inspector")  // admin, manager, inspector
  companyId String
  crewId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  company   Company  @relation(fields: [companyId], references: [id])
  crew      Crew?    @relation(fields: [crewId], references: [id])
  inspections Inspection[]
  refusals  Refusal[] @relation("RefusalLoggedBy")
  resolvedRefusals Refusal[] @relation("RefusalResolvedBy")
  productionEntries ProductionEntry[]
  punchItems PunchItem[]
  delayLogs DelayLog[]
  toolboxTalks ToolboxTalk[]
  safetyObservations SafetyObservation[]
  safetyIncidents SafetyIncident[]
  milestones Milestone[]
  documents Document[]
  cois Coi[]
  materials Material[]
  deliveries Delivery[]
  rfis      Rfi[]
  submittals Submittal[]
  galleryPhotos GalleryPhoto[]
  dailyLogs DailyLog[]
}

// Project - Solar installation project
model Project {
  id                String   @id @default(cuid())
  name              String
  location          String
  status            String   @default("active")  // active, completed, on_hold, archived
  health            String   @default("green")   // green, yellow, red
  // Manual drag-to-reorder position (Settings -> Projects), used everywhere
  // the project list renders - sidebar dropdown, Company Dashboard, Active
  // Projects grid. Not unique by itself; see the self-heal note on the
  // settings GET route for how pre-existing rows (all defaulted to 0) get
  // backfilled to stable values the first time this ships.
  sortOrder         Int      @default(0)
  client            String?
  startDate         DateTime?
  plannedEndDate    DateTime?
  projectManager    String?
  dailyTarget       Int      @default(35)
  
  // Pile map configuration
  totalRows         Int      @default(50)
  pilesPerRow       Int      @default(30)
  totalPiles        Int      @default(1500)
  pileNamingPrefix  String?  // e.g., "P", "Pile"
  // "grid" (default): the pile map is the procedural totalRows x pilesPerRow
  // rectangle above, as it always has been. "custom": this project has real
  // Pile records (imported or entered by hand) and the map renders those
  // instead - real row lengths, gaps for obstacles, per-pile type. Flips to
  // "custom" automatically the first time a Pile row is written for this
  // project; a manager can reset it back via the "clear custom layout"
  // action, which also deletes every Pile row for the project.
  pileLayoutMode    String   @default("grid")

  // Coordinates for this project's real weather forecast - optional; the
  // frontend falls back to a fixed Phoenix, AZ location when unset.
  latitude          Float?
  longitude         Float?

  // Planned totals for the other materials tracked via Production Entry.
  // Unlike totalPiles (derived from totalRows x pilesPerRow), these are
  // typed directly in Settings since there's no grid to derive them from.
  totalTables       Int      @default(0)
  totalModules      Int      @default(0)

  // Racking
  rackingProfileId  String?

  // Stats (computed or cached)
  installedPiles     Int      @default(0)
  tablesInstalled    Int      @default(0)
  modulesInstalled   Int      @default(0)
  passedInspections  Int      @default(0)
  failedInspections  Int      @default(0)
  refusalCount       Int      @default(0)
  
  companyId         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  company           Company           @relation(fields: [companyId], references: [id])
  rackingProfile    RackingProfile?  @relation(fields: [rackingProfileId], references: [id])
  piles             Pile[]
  inspections       Inspection[]
  refusals          Refusal[]
  productionEntries ProductionEntry[]
  punchItems        PunchItem[]
  delayLogs         DelayLog[]
  toolboxTalks       ToolboxTalk[]
  safetyObservations SafetyObservation[]
  safetyIncidents    SafetyIncident[]
  milestones         Milestone[]
  documents          Document[]
  cois               Coi[]
  materials          Material[]
  deliveries         Delivery[]
  rfis               Rfi[]
  submittals         Submittal[]
  galleryPhotos      GalleryPhoto[]
  dailyLogs          DailyLog[]
  moduleRows         ModuleRow[]
  spareModules       SpareModule[]
  brokenModules      BrokenModule[]
  moduleFlagHistory  ModuleFlagHistory[]
}

// Crew - Work crews
model Crew {
  id          String   @id @default(cuid())
  name        String
  lead        String?  // Crew lead name
  status      String   @default("active")  // active, standby, inactive
  workerCount Int      @default(8)
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  company           Company           @relation(fields: [companyId], references: [id])
  members           User[]
  productionEntries ProductionEntry[]
}

// Subcontractor
model Subcontractor {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  companyId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  company           Company           @relation(fields: [companyId], references: [id])
  productionEntries ProductionEntry[]
  cois              Coi[]
}

// RackingProfile - Manufacturer tolerance configurations
model RackingProfile {
  id           String   @id @default(cuid())
  name         String
  manufacturer String
  pileTypes    String   // JSON string, legacy: ["interior", "exterior", "motor", "corner"]
  tolerances   String   // JSON string, legacy: { interior: { embedmentMin: 72, plumbNS: 1.5 }, ... }
  // pileTypeSpecs replaces pileTypes/tolerances above. Each entry is a real
  // pile type as the racking manufacturer actually specs it (profile,
  // length, target embedment, a color to cross-reference the vendor's
  // color-coded pile plan) plus its own full tolerance set across all six
  // QC dimensions: { id, label, profile, lengthFt, embedmentTargetFt, color,
  // tolerances: { embedmentMinIn, embedmentMaxIn, heightMinIn, heightMaxIn,
  // plumbMaxDeg, twistMaxDeg, spacingTolIn, alignmentTolIn } }. The old
  // fields stay populated (derived) so nothing that still reads them breaks.
  pileTypeSpecs String? // JSON string: PileTypeSpec[]
  isActive     Boolean  @default(true)
  companyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  company   Company?   @relation(fields: [companyId], references: [id])
  projects  Project[]
}

// Pile - a single real pile position in a project's layout. Doesn't exist
// at all until a project is imported or hand-entered (Project.pileLayoutMode
// flips from "grid" to "custom" the first time one is written) - most
// projects still just use the procedural totalRows x pilesPerRow rectangle
// and have zero rows here. pileId follows the same "row-position" format
// Inspection/Refusal already key on (e.g. "35-22"), so nothing about how an
// inspection or refusal is recorded or looked up has to change.
model Pile {
  id       String   @id @default(cuid())
  pileId   String   // "row-position", matches Inspection/Refusal.pileId
  row      Int
  position Int      // order within the row - rows don't have to be contiguous
  zone     String?  // free text, e.g. "Zone 1" - groups rows in the Pile Layout view
  pileType String?  // id of a RackingProfile pile type spec (pileTypeSpecs[].id)
  color    String?  // vendor color-plan label, kept even when pileType isn't matched
  skip     Boolean  @default(false) // true = gap/obstacle placeholder, not a real pile
  lat      Float?
  lng      Float?
  notes    String?

  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, pileId])
  @@index([projectId, row])
}

// Inspection - QC inspection records
model Inspection {
  id         String   @id @default(cuid())
  pileId     String   // e.g., "35-22"
  row        Int
  pile       Int
  status     String   // pass, fail
  depth      Int?     // Embedment depth in inches
  plumbNS    Float?   // Plumb tolerance N-S
  plumbEW    Float?   // Plumb tolerance E-W
  pileType   String?  // id of the RackingProfile pile type spec this pile was checked against
  heightIn   Float?   // Reveal height above grade, in inches
  twistDeg   Float?   // Twist about the pile's vertical axis, in degrees
  spacingIn  Float?   // Deviation from design pile-to-pile spacing, in inches
  alignmentIn Float?  // Lateral deviation from the row's design line, in inches
  failReason String?
  notes      String?
  photos     String?  // JSON string: Array of photo URLs
  gps        String?  // JSON string: { lat, lng }
  
  projectId String
  userId    String
  createdAt DateTime @default(now())
  
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  
  @@unique([projectId, pileId])
}

// Refusal - Pile refusal records
model Refusal {
  id            String   @id @default(cuid())
  pileId        String
  row           Int
  pile          Int
  reason        String   // bedrock, cobble, obstruction, groundwater, etc.
  targetDepth   Int      // Target embedment
  achievedDepth Int?     // Actual depth achieved
  notes         String?
  photos        String?  // JSON string
  gps           String?  // JSON string
  status        String   @default("open")  // open, resolved, redesign_required
  // Remediation - what was actually done to close this out (re-driven,
  // engineered footing approved, etc.), separate from `notes` above,
  // which captures what was encountered in the field at the time of the
  // original refusal. Set together with `status` via PATCH /api/refusals.
  resolutionNotes String?
  resolvedById    String?
  resolvedAt      DateTime?

  projectId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project @relation(fields: [projectId], references: [id])
  user       User    @relation(fields: [userId], references: [id], name: "RefusalLoggedBy")
  resolvedBy User?   @relation(fields: [resolvedById], references: [id], name: "RefusalResolvedBy")

  @@unique([projectId, pileId])
}

// Notification - In-app alerts (failed inspection, new refusal, a day's
// production falling well short of target). No email/SMS - these are read
// inside the app only, cleared per-company as they're marked read.
model Notification {
  id        String   @id @default(cuid())
  type      String   // inspection_fail, refusal, behind_schedule
  message   String
  read      Boolean  @default(false)
  companyId String
  projectId String?
  createdAt DateTime @default(now())

  company   Company  @relation(fields: [companyId], references: [id])
}

// PunchItem - Closeout punch list. Not always tied to a specific pile (a
// gate repair or exposed grounding cable has no pileId), so location is
// free text rather than the strict row/pile pair the field-entry models use.
model PunchItem {
  id          String    @id @default(cuid())
  // Auto-numbered PI-001, PI-002, ... per project, same convention as
  // Rfi.number/Submittal.number - nullable only because existing items
  // predate this field; /api/punchlist backfills any null one it finds
  // on the next GET, oldest-first, so every item gets one without a
  // manual migration.
  number      String?
  description String
  location    String?   // free text - pile id, row, or general area
  status      String    @default("open")   // open, in_progress, resolved
  priority    String    @default("medium") // low, medium, high
  assignedTo  String?   // free text name - not required to be a registered user
  dueDate     DateTime?
  photos      String?   // JSON string: Array of photo URLs
  resolutionPhotos String? // JSON string: Array of photo URLs proving the fix - required to resolve, see /api/punchlist
  notes       String?
  resolvedAt  DateTime?

  projectId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

// Module scanning + placement map - see
// claude/module-barcode-scanning-design.md in the project. Replaces the
// Excel-based field workflow (Bluetooth scanner + iPad into a spreadsheet)
// with the same ROWTAG-{rowId} convention Glen's crews already use on
// their printed/laminated tags: scanning a row tag starts/resumes that
// row, then each module scan auto-increments position within it - no
// manual position entry, ever. Mirrors Pile/Pile Map's "real layout,
// built live" pattern rather than Pile Map's procedural-grid mode, since
// every site's module layout is hand-laid-out like a custom pile layout
// anyway (no two sites are the same - no fixed rows x columns rectangle).
model ModuleRow {
  id            String   @id @default(cuid())
  rowId         String   // the row's real identity, from ROWTAG-{this} - whatever format a project's tags use (a bare number, "N-1", anything)
  // Manual row-to-row alignment: how many blank placeholder cells lead
  // this row in the Module Map, for sites where rows don't start evenly
  // (mirrors Pile's `skip` gap-placeholder idea, but as a single leading
  // count per row instead of per-cell, since within-row position is
  // already fully derived from scan order and never needs gaps of its
  // own).
  offset        Int      @default(0)
  expectedCount Int?     // optional, validation only - flags a short/over row, never blocks a scan
  projectId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id])
  slots   ModuleSlot[]

  @@unique([projectId, rowId])
}

model ModuleSlot {
  id          String    @id @default(cuid())
  moduleRowId String
  position    Int       // 1, 2, 3... in scan order within this row - fully auto-derived, never manually entered
  barcode     String?   // null until scanned; a rescan here (or a barcode already recorded elsewhere) is always flagged, never silently overwritten - see /api/module-slots
  scannedAt   DateTime?
  scannedBy   String?   // free text name, same convention as PunchItem.assignedTo
  notes       String?

  // Found broken AFTER install (hail, a forklift strike, whatever shows up
  // weeks later on a walk-through) - deliberately NOT the same thing as
  // BrokenModule below, which is "never made it into a row" inventory.
  // This stays on the slot itself (same row/position it's always had) so
  // it shows up right on the Module Map where the field already looks,
  // instead of flag tape that falls off or a note on a clipboard. Cleared
  // either by scanning a replacement into this same slot (see action
  // 'replace' in /api/module-slots, which also writes a ModuleFlagHistory
  // row) or by an explicit "mark resolved" with no swap.
  flaggedBroken Boolean   @default(false)
  flaggedReason String?
  flaggedBy     String?
  flaggedAt     DateTime?

  moduleRow ModuleRow @relation(fields: [moduleRowId], references: [id])

  @@unique([moduleRowId, position])
}

// One row per resolved post-install flag (see ModuleSlot.flaggedBroken) -
// written only at resolution time, carrying both halves of the story
// (what was flagged and why, what it got resolved as) in a single record.
// rowId is the row's display id (ModuleRow.rowId), not its internal id,
// so this stays meaningful even if the row record itself ever changes.
// Kept for warranty/backcharge paper trail purposes, same spirit as
// SpareModule/BrokenModule below.
model ModuleFlagHistory {
  id          String   @id @default(cuid())
  projectId   String
  rowId       String
  position    Int
  oldBarcode  String
  reason      String
  flaggedBy   String?
  flaggedAt   DateTime
  resolution  String   // "replaced" | "cleared" (cleared = resolved with no barcode swap)
  newBarcode  String?  // set only when resolution = "replaced"
  resolvedBy  String?
  resolvedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

// Flat inventory logs - Glen: "I don't need tracking of them in the
// field. Only need to record the serials for inventory use and potential
// backcharging etc. I don't care where they came from." No slot/position
// link at all, on purpose.
model SpareModule {
  id        String   @id @default(cuid())
  barcode   String
  notes     String?
  loggedBy  String?
  loggedAt  DateTime @default(now())
  projectId String

  project Project @relation(fields: [projectId], references: [id])
}

model BrokenModule {
  id        String   @id @default(cuid())
  barcode   String
  reason    String   // "DOA" | "Damaged in Field" | "Broken During Install" - Glen's existing fixed categories
  notes     String?
  loggedBy  String?
  loggedAt  DateTime @default(now())
  projectId String

  project Project @relation(fields: [projectId], references: [id])
}

// DelayLog - Non-productive day tracking (weather, permitting holds,
// equipment down, material shortages). Separate from ProductionEntry so a
// day can carry a delay reason whether or not any piles were installed -
// this is what backs up schedule conversations with the client.
model DelayLog {
  id          String   @id @default(cuid())
  date        DateTime
  reason      String   // weather, permitting_hold, equipment_down, material_shortage, other
  description String?
  hoursLost   Float?

  projectId String
  userId    String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, date])
}

// ToolboxTalk - Safety - brief pre-shift safety topic covered with a crew.
model ToolboxTalk {
  id            String   @id @default(cuid())
  topic         String
  conductedBy   String   // free text name - not required to be a registered user
  crewName      String?
  attendeeCount Int      @default(0)
  notes         String?
  date          DateTime @default(now())

  projectId String
  userId    String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

// SafetyObservation - Safety - a positive or at-risk behavior/condition
// spotted in the field, logged the same way an inspection or refusal is.
model SafetyObservation {
  id          String   @id @default(cuid())
  type        String   // positive, at_risk
  category    String   // ppe, housekeeping, fall_protection, equipment, other
  location    String?  // free text - pile id, row, or general area
  description String
  photos      String?  // JSON string: Array of photo URLs

  projectId String
  userId    String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

// SafetyIncident - Safety - near-misses and actual incidents, with a
// corrective action and an open/closed status so nothing gets dropped.
model SafetyIncident {
  id               String    @id @default(cuid())
  severity         String    // near_miss, minor, recordable
  description      String
  correctiveAction String?
  status           String    @default("open") // open, closed
  photos           String?   // JSON string
  resolvedAt       DateTime?

  projectId String
  userId    String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

// Milestone - Schedule - planned vs actual for major project phases. The
// client treats "Pile Driving" specially: its actual percentComplete is
// derived live from the project's real installed/total pile counts rather
// than typed in by hand, the same source of truth as everywhere else in
// the app. Every other phase tracks percentComplete directly.
model Milestone {
  id              String    @id @default(cuid())
  phase           String    // e.g. "Mobilization", "Pile Driving", "Racking Install"
  sortOrder       Int       @default(0)
  plannedStart    DateTime?
  plannedEnd      DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  status          String    @default("not_started") // not_started, on_track, at_risk, delayed, complete
  percentComplete Int       @default(0)

  projectId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

// Document - Documents & COI - project paperwork: site plans, IFC drawing
// sets, permits, as-builts, spec sheets. fileKey/fileUrl point at the same
// private storage bucket photos use (see uploadFile in lib/storage.ts) -
// fileUrl is a same-origin /api/photos/<key> path regardless of file type,
// since that route just streams whatever bytes/content-type it finds.
model Document {
  id       String  @id @default(cuid())
  title    String
  category String  // site_plans, ifc_drawings, as_builts, permits, specs, other
  fileKey  String
  fileUrl  String
  fileType String? // original MIME type
  fileSize Int?    // bytes

  projectId String
  userId    String
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

// GalleryPhoto - a photo added straight to the project's photo gallery,
// not attached to an inspection, refusal, or production log entry (the
// "a supervisor stops by with a phone full of site photos" case). The
// gallery view in the app also shows photos FROM those other records,
// but those stay owned by their own model - this one is only for photos
// that have no other home. date is the calendar day the photo is filed
// under for the gallery's month grouping (defaults to upload day, but is
// editable like every other date in this app) - deliberately separate
// from createdAt, which is just when the row was written.
model GalleryPhoto {
  id        String   @id @default(cuid())
  fileKey   String
  fileUrl   String
  caption   String?
  date      DateTime
  createdAt DateTime @default(now())

  projectId String
  userId    String

  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

// Coi - Documents & COI - subcontractor certificates of insurance, tracked
// per coverage type with an expiration date so the app can flag one going
// stale before it actually lapses (see coiStatus() in page.tsx).
model Coi {
  id           String   @id @default(cuid())
  coverageType String   // general_liability, workers_comp, auto_liability, umbrella, other
  expiresAt    DateTime
  fileKey      String?
  fileUrl      String?

  subcontractorId String
  projectId       String
  userId          String
  createdAt       DateTime @default(now())

  subcontractor Subcontractor @relation(fields: [subcontractorId], references: [id])
  project       Project       @relation(fields: [projectId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
}

// Material - Materials - bill-of-materials line items tracked against what
// has actually been delivered to site. deliveredQty is a running total,
// kept in sync from each Delivery entry rather than typed by hand.
model Material {
  id           String    @id @default(cuid())
  name         String
  orderedQty   Int       @default(0)
  deliveredQty Int       @default(0)
  unit         String    @default("units")
  expectedDate DateTime?
  supplier     String?

  projectId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project    @relation(fields: [projectId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  deliveries Delivery[]
  submittals Submittal[]
}

// Delivery - Materials - individual delivery log entries against a
// Material line item; each one increments that material's deliveredQty.
model Delivery {
  id         String   @id @default(cuid())
  quantity   Int
  supplier   String?
  receivedBy String?  // free text name
  date       DateTime @default(now())
  notes      String?

  materialId String
  projectId  String
  userId     String
  createdAt  DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

// Rfi - Request for Information. A question raised against a project that
// needs an answer from engineering/ownership before work can proceed.
model Rfi {
  id          String    @id @default(cuid())
  number      String
  subject     String
  category    String    @default("other") // civil, structural, electrical, racking, other
  question    String
  submittedTo String?
  blocking    Boolean   @default(false)
  status      String    @default("open") // open, answered, closed
  answer      String?
  answeredAt  DateTime?
  photos      String?   // JSON string

  projectId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

// Submittal - Document Control. A product data sheet, shop drawing, sample,
// or certificate submitted for review/approval, optionally tied to a
// Material line item.
model Submittal {
  id          String    @id @default(cuid())
  number      String
  specSection String
  type        String    @default("product_data") // product_data, shop_drawing, sample, certificate
  revision    Int       @default(0)
  status      String    @default("pending") // pending, submitted, under_review, approved, approved_as_noted, revise_resubmit, rejected
  dueDate     DateTime?
  fileKey     String?
  fileUrl     String?

  materialId String?
  projectId  String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  material  Material? @relation(fields: [materialId], references: [id])
  project   Project   @relation(fields: [projectId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

// ProductionEntry - Daily production logs
model ProductionEntry {
  id                String   @id @default(cuid())
  date              DateTime
  pilesInstalled    Int      @default(0)
  tablesInstalled   Int      @default(0)
  modulesInstalled  Int      @default(0)
  notes          String?
  photos         String?  // JSON string
  
  projectId       String
  crewId          String?
  userId          String
  subcontractorId String?
  createdAt       DateTime @default(now())
  
  project       Project        @relation(fields: [projectId], references: [id])
  crew          Crew?          @relation(fields: [crewId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  subcontractor Subcontractor? @relation(fields: [subcontractorId], references: [id])
  
  @@unique([projectId, date])
}

// DailyLog - a supervisor's narrative record of a day on site: crew on
// site, weather, visitors, and a free-text summary of the day - the
// things that don't have a home in any of the structured tabs
// (Production, Delays, Safety, etc.) and would otherwise go unrecorded
// or get stuffed into a field that isn't meant for them. One per
// project per calendar day, same upsert pattern as ProductionEntry and
// DelayLog - re-logging the same day updates it instead of creating a
// second row. crew is a JSON string of [{ trade, count }] rows rather
// than a single headcount, since a day's crew is normally a handful of
// subs/trades, not one number. Its narrative/crew/weather feed the
// Daily Report PDF's notes section (see generateDailyReport in
// page.tsx); its photos join the project's unified photo list via
// buildGalleryPhotos, same as every other photo-bearing model.
model DailyLog {
  id        String   @id @default(cuid())
  date      DateTime
  crew      String?  // JSON string: [{ trade, count }]
  weather   String?
  visitors  String?
  narrative String?
  photos    String?  // JSON string

  projectId String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, date])
}

// Session for NextAuth
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}
